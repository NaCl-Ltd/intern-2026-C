<li id="micropost-<%= micropost.id %>">
  <%= link_to gravatar_for(micropost.user, size: 50), micropost.user %>
  <span class="user"><%= link_to micropost.user.name, micropost.user %></span>
  <span class="content">
    <%= micropost.content %>
    <% if micropost.image.attached? %>
      <%= image_tag micropost.image.variant(:display) %>
    <% end %>
  </span>
  <span class="timestamp">
    Posted <%= time_ago_in_words(micropost.created_at) %> ago.
    <% if current_user?(micropost.user) %>
      <%= link_to "delete", micropost, data: { "turbo-method": :delete,
                                               turbo_confirm: "You sure?" } %>
      <% if current_user.pinned_micropost_id == micropost.id %>
        | <%= button_to "固定解除", unpin_micropost_path(micropost), method: :patch, style: "display:inline;" %>
      <% else %>
        | <%= button_to "固定する", pin_micropost_path(micropost), method: :patch, style: "display:inline;" %>
      <% end %>
    <% end %>
    <% like = current_user.likes.find_by(micropost_id: micropost.id) %>
    <% if like %>
    | <%= link_to "❤️ #{micropost.likes.count}", like_path(like), data: { "turbo-method": :delete } %>
    <% else %>
    | <%= link_to "🤍 #{micropost.likes.count}", likes_path(micropost_id: micropost.id), data: { "turbo-method": :post } %>
    <% end %>
  </span>
</li>
